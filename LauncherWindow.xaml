<ui:JelloWindow x:Class="JelloClient.LauncherWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                xmlns:ui="clr-namespace:JelloClient.UI"
                Title="Jello Client"
                Width="420"
                Height="520"
                ResizeMode="NoResize"
                WindowStartupLocation="CenterScreen"
                FontFamily="{StaticResource UiFont}"
                Icon="/Assets/icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeButton"
                    Style="{StaticResource CaptionButton}"
                    Tag="{StaticResource IconMinimize}"
                    ToolTip="Minimize"
                    Click="MinimizeButton_Click" />
            <Button Style="{StaticResource CloseButton}"
                    Tag="{StaticResource IconClose}"
                    ToolTip="Close"
                    Click="CloseButton_Click" />
        </StackPanel>

        <Border x:Name="AnnouncementBanner"
                Grid.Row="1"
                VerticalAlignment="Top"
                Panel.ZIndex="100"
                Visibility="Collapsed"
                Margin="14,2,14,0"
                CornerRadius="10"
                Padding="12,9"
                Cursor="Hand"
                ToolTip="Click to dismiss"
                MouseLeftButtonUp="AnnouncementBanner_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AnnouncementDot" Text="●" FontSize="13" VerticalAlignment="Top" Margin="0,0,8,0" Foreground="White" Opacity="0.9" />
                <TextBlock x:Name="AnnouncementText" TextWrapping="Wrap" Foreground="White" FontSize="12.5" MaxWidth="320" />
            </StackPanel>
        </Border>

        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="28,0,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="BrandPanel" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Rectangle x:Name="LogoImage"
                           Style="{StaticResource LogoMark}"
                           Width="128"
                           Height="128" />
                <TextBlock Text="JELLO"
                           FontFamily="{StaticResource PoppinsFont}"
                           FontWeight="Bold"
                           FontSize="28"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
                <TextBlock x:Name="AppVersionText"
                           FontFamily="{StaticResource PoppinsFont}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel x:Name="InfoPanel" Grid.Row="1" Margin="0,0,0,16">
                <TextBlock x:Name="InstalledVersionText"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LastPlayedText"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0"
                           Visibility="Collapsed" />
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
                <ProgressBar x:Name="InstallProgressBar"
                             Style="{StaticResource ThinProgressBar}"
                             Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="1"
                             Visibility="Collapsed" />
            </StackPanel>

            <Button x:Name="LaunchButton"
                    Grid.Row="2"
                    Style="{StaticResource LaunchButton}"
                    Content="LAUNCH GAME"
                    Click="LaunchButton_Click" />

            <Grid x:Name="ActionRow" Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SettingsButton"
                        Grid.Column="0"
                        Style="{StaticResource FluentButton}"
                        Content="Settings"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="SettingsButton_Click" />
                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Style="{StaticResource FluentButton}"
                        Content="Cancel"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Visibility="Collapsed"
                        Click="CancelButton_Click" />
                <Button x:Name="ServerInfoButton"
                        Grid.Column="2"
                        Style="{StaticResource FluentButton}"
                        Content="Server info"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Visibility="Collapsed"
                        Click="ServerInfoButton_Click" />
            </Grid>

            <Button x:Name="SupportButton"
                    Grid.Row="4"
                    Style="{StaticResource SupportLink}"
                    Margin="0,12,0,0"
                    ToolTip="Opens the Jello support server in your browser"
                    Click="SupportButton_Click">
                <TextBlock Text="Support server" FontSize="12.5" />
            </Button>
        </Grid>
    </Grid>
</ui:JelloWindow>

# Normalize line endings on commit; keep native endings in the working tree.
* text=auto

# Explicit text types
*.cs        text diff=csharp
*.xaml      text
*.csproj    text
*.manifest  text
*.md        text
*.txt       text
*.json      text

# Binary assets (never diffed or normalized)
*.png       binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.mp3       binary
*.rbxl      binary
*.exe       binary
*.dll       binary

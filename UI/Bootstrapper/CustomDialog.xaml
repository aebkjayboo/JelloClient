<bs:BootstrapperWindow x:Class="JelloClient.UI.Bootstrapper.CustomDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:bs="clr-namespace:JelloClient.UI.Bootstrapper"
                       xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                       Width="420"
                       Height="330"
                       AllowsTransparency="True"
                       Background="Transparent"
                       Icon="/Assets/icon.ico">

    <Border x:Name="Shell" CornerRadius="10" Background="#FF141414" ClipToBounds="True">
        <Grid>
            <wv2:WebView2 x:Name="Panel" DefaultBackgroundColor="Transparent" />

            <Border x:Name="Fallback" Background="#FF141414" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="28">
                    <TextBlock Text="Theme could not load"
                               FontFamily="{StaticResource PoppinsFont}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="FallbackText"
                               Margin="0,10,0,0"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</bs:BootstrapperWindow>

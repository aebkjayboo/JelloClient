<bs:BootstrapperWindow x:Class="JelloClient.UI.Bootstrapper.ProgressDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:bs="clr-namespace:JelloClient.UI.Bootstrapper"
                       Width="400"
                       Height="150"
                       AllowsTransparency="False"
                       Background="Transparent"
                       Icon="/Assets/icon.ico">

    <Border Background="#FFF0F0F0" BorderBrush="#FF8A8A8A" BorderThickness="1">
        <Grid Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="MessageText"
                       Grid.Row="0"
                       Text="Please wait..."
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Foreground="#FF000000"
                       TextTrimming="CharacterEllipsis" />

            <ProgressBar x:Name="Progress"
                         Grid.Row="1"
                         Height="20"
                         Margin="0,12,0,0"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="True" />

            <Button x:Name="CancelButton"
                    Grid.Row="2"
                    Content="Cancel"
                    Width="88"
                    Height="26"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="Cancel_Click" />
        </Grid>
    </Border>
</bs:BootstrapperWindow>

<bs:BootstrapperWindow x:Class="JelloClient.UI.Bootstrapper.LegacyDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:bs="clr-namespace:JelloClient.UI.Bootstrapper"
                       Width="350"
                       Height="125"
                       AllowsTransparency="False"
                       Background="Transparent"
                       Icon="/Assets/icon.ico">

    <Border Background="#FFECECEC" BorderBrush="#FF707070" BorderThickness="1">
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Jello Client"
                       FontFamily="Tahoma"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#FF000000" />

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="0,6,0,0"
                       Text="Please wait..."
                       FontFamily="Tahoma"
                       FontSize="11"
                       Foreground="#FF000000"
                       TextTrimming="CharacterEllipsis" />

            <ProgressBar x:Name="Progress"
                         Grid.Row="2"
                         Height="16"
                         Margin="0,10,0,0"
                         VerticalAlignment="Top"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="True" />
        </Grid>
    </Border>
</bs:BootstrapperWindow>

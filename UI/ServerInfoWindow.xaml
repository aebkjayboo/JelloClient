<ui:JelloWindow x:Class="JelloClient.UI.ServerInfoWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                xmlns:ui="clr-namespace:JelloClient.UI"
                Title="Server information"
                Width="480"
                SizeToContent="Height"
                ResizeMode="NoResize"
                ShowInTaskbar="False"
                WindowStartupLocation="CenterScreen"
                FontFamily="{StaticResource UiFont}"
                Icon="/Assets/icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Server information"
                       Margin="16,0,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CloseButton}"
                        Tag="{StaticResource IconClose}"
                        ToolTip="Close"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,4,20,20">

            <TextBlock Style="{StaticResource SectionHeader}" Text="Experience" Margin="0,0,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Name" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UniverseNameText" Style="{StaticResource InfoValue}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Place ID" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PlaceText" Style="{StaticResource InfoValue}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Universe ID" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UniverseIdText" Style="{StaticResource InfoValue}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Players" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PlayersText" Style="{StaticResource InfoValue}" />
            </Grid>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Server" Margin="0,6,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Type" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ServerTypeText" Style="{StaticResource InfoValue}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Job ID" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="JobIdText" Style="{StaticResource InfoValue}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Address" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AddressText" Style="{StaticResource InfoValue}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />

                <TextBlock Grid.Row="3" Grid.Column="0" x:Name="HostnameLabel" Style="{StaticResource InfoLabel}" Text="Hostname" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HostnameText" Style="{StaticResource InfoValue}" />

                <TextBlock Grid.Row="4" Grid.Column="0" x:Name="LocationLabel" Style="{StaticResource InfoLabel}" Text="Location" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LocationText" Style="{StaticResource InfoValue}" />

                <TextBlock Grid.Row="5" Grid.Column="0" x:Name="ProviderLabel" Style="{StaticResource InfoLabel}" Text="Provider" />
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ProviderText" Style="{StaticResource InfoValue}" />

                <TextBlock Grid.Row="6" Grid.Column="0" x:Name="PingLabel" Style="{StaticResource InfoLabel}" Text="Ping" />
                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="PingText" Style="{StaticResource InfoValue}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource InfoLabel}" Text="Joined" />
                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="JoinedText" Style="{StaticResource InfoValue}" />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CopyDetailsButton"
                        Grid.Column="0"
                        Style="{StaticResource AccentButton}"
                        Content="Copy details"
                        HorizontalContentAlignment="Center"
                        Click="CopyDetails_Click" />
                <Button x:Name="CopyJobIdButton"
                        Grid.Column="2"
                        Style="{StaticResource FluentButton}"
                        Content="Copy job ID"
                        HorizontalContentAlignment="Center"
                        Click="CopyJobId_Click" />
                <Button x:Name="CopyInviteButton"
                        Grid.Column="4"
                        Style="{StaticResource FluentButton}"
                        Content="Copy join link"
                        HorizontalContentAlignment="Center"
                        Click="CopyInvite_Click" />
            </Grid>

            <TextBlock x:Name="CopyStatusText"
                       FontSize="12"
                       Foreground="{DynamicResource TextTertiary}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</ui:JelloWindow>

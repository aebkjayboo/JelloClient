                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="10,6"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <StackPanel VerticalAlignment="Center">
                                <RepeatButton x:Name="PART_HoursUp"
                                              Style="{StaticResource StepperButton}"
                                              Tag="{StaticResource IconChevronUp}" />
                                <RepeatButton x:Name="PART_HoursDown"
                                              Style="{StaticResource StepperButton}"
                                              Tag="{StaticResource IconChevronDown}" />
                            </StackPanel>

                            <TextBlock Text="{Binding HoursText, RelativeSource={RelativeSource TemplatedParent}}"
                                       MinWidth="26"
                                       Margin="4,0,2,0"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource PoppinsFont}"
                                       FontSize="19"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="h"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,10,3"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}" />

                            <StackPanel VerticalAlignment="Center">
                                <RepeatButton x:Name="PART_MinutesUp"
                                              Style="{StaticResource StepperButton}"
                                              Tag="{StaticResource IconChevronUp}" />
                                <RepeatButton x:Name="PART_MinutesDown"
                                              Style="{StaticResource StepperButton}"
                                              Tag="{StaticResource IconChevronDown}" />
                            </StackPanel>

                            <TextBlock Text="{Binding MinutesText, RelativeSource={RelativeSource TemplatedParent}}"
                                       MinWidth="30"
                                       Margin="4,0,2,0"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource PoppinsFont}"
                                       FontSize="19"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="min"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,2,3"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SupportLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SupportBlue}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="8,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillTertiary}" />
                            <Setter Property="Foreground" Value="{DynamicResource SupportBlueHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LogoMark" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource LogoFill}" />
        <Setter Property="OpacityMask">
            <Setter.Value>
                <ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="Uniform" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InstallerStep" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Current">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="Tag" Value="Done">
                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

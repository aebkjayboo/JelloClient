<ui:JelloWindow x:Class="JelloClient.SettingsWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                xmlns:ui="clr-namespace:JelloClient.UI"
                xmlns:ctrl="clr-namespace:JelloClient.UI.Controls"
                xmlns:conv="clr-namespace:JelloClient.UI.Converters"
                Title="Jello Client Settings"
                Width="1000"
                Height="700"
                MinWidth="820"
                MinHeight="560"
                WindowStartupLocation="CenterScreen"
                ResizeMode="CanResize"
                FontFamily="{StaticResource UiFont}"
                Icon="/Assets/icon.ico">

    <FrameworkElement.Resources>
        <conv:TagColorConverter x:Key="TagColour" />
        <conv:CountToBoolConverter x:Key="CountToBool" />
    </FrameworkElement.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Settings"
                       Margin="24,0,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButton}"
                        Tag="{StaticResource IconMinimize}"
                        ToolTip="Minimize"
                        Click="MinimizeButton_Click" />
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButton}"
                        Tag="{StaticResource IconMaximize}"
                        ToolTip="Maximize"
                        Click="MaximizeButton_Click" />
                <Button Style="{StaticResource CloseButton}"
                        Tag="{StaticResource IconClose}"
                        ToolTip="Close"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,4,0,14">
            <Rectangle Style="{StaticResource LogoMark}"
                       Width="64"
                       Height="64"
                       VerticalAlignment="Center" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Jello Client"
                           FontFamily="{StaticResource PoppinsFont}"
                           FontWeight="SemiBold"
                           FontSize="22"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="HeaderVersionText"
                           FontFamily="{StaticResource PoppinsFont}"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiary}"
                           Margin="0,1,0,0" />
            </StackPanel>
        </StackPanel>

        <TabControl x:Name="NavRailTabs" Grid.Row="2" Style="{StaticResource NavRail}">

            <TabItem Style="{StaticResource NavItem}" Header="Deployment" Tag="{StaticResource IconPackage}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Deployment" />
                    <TextBlock Style="{StaticResource PageDescription}" Text="Where Jello pulls Roblox from and how it starts the client." />

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="InstalledVersionText" Style="{StaticResource CardHeader}" Text="Checking installation..." />
                                <TextBlock x:Name="InstalledChannelText" Style="{StaticResource CardDescription}" Text="" />
                            </StackPanel>
                            <Button x:Name="UpdateRobloxButton"
                                    Grid.Column="1"
                                    Style="{StaticResource FluentButton}"
                                    Content="Check for updates"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="UpdateRoblox_Click" />
                        </Grid>
                    </Border>

                    <Border x:Name="ProgressCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="ProgressStageText" Style="{StaticResource CardHeader}" Text="" />
                                <Button Style="{StaticResource FluentButton}"
                                        Content="Cancel"
                                        HorizontalAlignment="Right"
                                        Click="CancelInstall_Click" />
                            </Grid>
                            <ProgressBar x:Name="InstallProgressBar"
                                         Style="{StaticResource ThinProgressBar}"
                                         Margin="0,12,0,0"
                                         Minimum="0"
                                         Maximum="1" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Channel" />
                                <TextBlock x:Name="ChannelHintText" Style="{StaticResource CardDescription}" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="ResetChannelButton"
                                        Style="{StaticResource FluentButton}"
                                        Content="Reset to production"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Click="ResetChannel_Click" />
                                <TextBox x:Name="ChannelBox"
                                         Style="{StaticResource FluentTextBox}"
                                         Width="180"
                                         LostFocus="ChannelBox_LostFocus" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Multi-instance" />
                                <TextBlock Style="{StaticResource CardDescription}"
                                           TextWrapping="Wrap"
                                           Text="Holds the Roblox singleton mutex so more than one client can run at once, and gives each extra client its own copy of the version folder, built from hard links so it costs no real disk space. Without that second part Roblox shuts the new client down on its own, whatever the mutex says. Jello must stay open for this to keep working." />
                            </StackPanel>
                            <CheckBox x:Name="MultiInstanceToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="MultiInstanceToggle_Changed"
                                      Unchecked="MultiInstanceToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Reinstall Roblox" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Deletes every downloaded version folder so the next launch fetches a clean copy. Your flags and modifications are kept." />
                            </StackPanel>
                            <Button x:Name="ReinstallButton"
                                    Grid.Column="1"
                                    Style="{StaticResource FluentButton}"
                                    Content="Delete installs"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="Reinstall_Click" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Server matchmaking" Margin="0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HelpBadge}"
                                ToolTip="Before launching, Jello asks Roblox for a few servers, times the round trip to each, and joins the fastest - a real handshake, not a guess from a map.&#10;&#10;Roblox has largely closed this off: on this build the lookup answered once, then refused every request for the better part of an hour. Jello falls back to an ordinary launch whenever a lookup is refused, so the worst case is that it does nothing and adds a second to your launch. It is off by default for that reason. It sends your Roblox login with each lookup, read from this machine and sent only to roblox.com.">
                            <TextBlock Style="{StaticResource HelpBadgeMark}" />
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Join the fastest server" />
                                <TextBlock x:Name="MatchmakerText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                            </StackPanel>
                            <CheckBox x:Name="MatchmakerToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      Click="Matchmaker_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="How many to check" />
                                <TextBlock x:Name="MatchmakerBudgetText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <ComboBox x:Name="MatchmakerBudgetCombo"
                                          Style="{StaticResource FluentComboBox}"
                                          Width="120"
                                          Margin="0,0,8,0"
                                          SelectionChanged="MatchmakerBudget_Changed" />
                                <ComboBox x:Name="MatchmakerFillCombo"
                                          Style="{StaticResource FluentComboBox}"
                                          Width="140"
                                          SelectionChanged="MatchmakerFill_Changed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Launch behaviour" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Confirm launches" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Asks before starting Roblox, including when a launch comes in from the website." />
                            </StackPanel>
                            <CheckBox x:Name="ConfirmLaunchesToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="ConfirmLaunchesToggle_Changed"
                                      Unchecked="ConfirmLaunchesToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Hide the launcher after launching" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Sends the launcher window to the notification area once Roblox is running." />
                            </StackPanel>
                            <CheckBox x:Name="HideOnLaunchToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="HideOnLaunchToggle_Changed"
                                      Unchecked="HideOnLaunchToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Close to the notification area" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Closing the launcher hides it instead of quitting, so activity tracking and the singleton mutex survive. Use Exit in the tray menu to quit." />
                            </StackPanel>
                            <CheckBox x:Name="CloseToTrayToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="CloseToTrayToggle_Changed"
                                      Unchecked="CloseToTrayToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Handle Roblox launch links" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Points the roblox: and roblox-player: links from the Roblox website at Jello instead of the stock bootstrapper, so your flags and modifications apply to every join." />
                            </StackPanel>
                            <CheckBox x:Name="ProtocolToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="ProtocolToggle_Changed"
                                      Unchecked="ProtocolToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Start with Windows" />
                                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="Starts Jello in the notification area when you sign in, so launches from the website are handled right away. This is the same entry the Startup tab of Task Manager lists." />
                            </StackPanel>
                            <CheckBox x:Name="StartupToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="StartupToggle_Changed"
                                      Unchecked="StartupToggle_Changed" />
                        </Grid>
                    </Border>

                </StackPanel>
            </TabItem>

            <TabItem Style="{StaticResource NavItem}" Header="FastFlags" Tag="{StaticResource IconFlag}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="FastFlags" />
                    <TextBlock Style="{StaticResource PageDescription}"
                               TextWrapping="Wrap"
                               Text="Manage your FastFlags. A tick in Preset means the flag comes from a preset on the Presets tab, a cross means you added it yourself. Written to ClientSettings\ClientAppSettings.json each time Jello launches Roblox." />

                    <Border x:Name="FlagAuditBanner"
                            Visibility="Collapsed"
                            Margin="0,4,0,10"
                            Padding="14,11"
                            CornerRadius="6"
                            Background="{DynamicResource DangerFill}">
                        <StackPanel>
                            <TextBlock x:Name="FlagAuditHeadline"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="13.5"
                                       TextWrapping="Wrap"
                                       Text="" />
                            <TextBlock x:Name="FlagAuditDetail"
                                       Foreground="White"
                                       FontSize="12.5"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Opacity="0.92"
                                       Text="" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <ToggleButton x:Name="EditorTabButton"
                                      Style="{StaticResource ChipToggle}"
                                      Content="Editor"
                                      Margin="0,0,8,0"
                                      IsChecked="True"
                                      Click="FlagView_Click" />
                        <ToggleButton x:Name="PresetsTabButton"
                                      Style="{StaticResource ChipToggle}"
                                      Content="Presets"
                                      Click="FlagView_Click" />
                    </StackPanel>

                    <StackPanel x:Name="EditorView">
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FluentButton}"
                                    Content="Add new"
                                    Margin="0,0,10,10"
                                    Click="AddFlag_Click" />
                            <Button Style="{StaticResource DangerButton}"
                                    Content="Delete selected"
                                    Margin="0,0,10,10"
                                    MinWidth="130"
                                    Click="DeleteSelectedFlags_Click">
                                <Button.IsEnabled>
                                    <Binding ElementName="FlagGrid" Path="SelectedItems.Count" Converter="{StaticResource CountToBool}" />
                                </Button.IsEnabled>
                            </Button>
                            <Button Style="{StaticResource FluentButton}"
                                    Content="Delete all"
                                    Margin="0,0,10,10"
                                    Click="DeleteAllFlags_Click" />
                            <ToggleButton x:Name="ShowPresetFlagsButton"
                                          Style="{StaticResource ChipToggle}"
                                          Content="Show preset flags"
                                          MinWidth="150"
                                          Margin="0,0,10,10"
                                          IsChecked="True"
                                          Click="ShowPresetFlags_Click" />
                        </WrapPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBox x:Name="FlagSearchBox"
                                         Style="{StaticResource FluentTextBox}"
                                         Padding="10,7"
                                         TextChanged="FlagSearch_Changed" />
                                <TextBlock Text="Search for a flag by name or value"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource TextTertiary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FlagSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TotalFlagsText" Style="{StaticResource FlagsCounter}" Text="Flags added: 0" />
                                <TextBlock x:Name="BloatText" Style="{StaticResource FlagsCounter}" Margin="0" Text="Bloat: 0%" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Border Style="{StaticResource FlagGridSurface}" Height="360">
                                <DataGrid x:Name="FlagGrid"
                                          Style="{StaticResource FlagDataGrid}"
                                          CellEditEnding="FlagGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Tags" Width="180" IsReadOnly="True" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding VisibleTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource TagPill}"
                                                                        Background="{Binding ., Converter={StaticResource TagColour}}">
                                                                    <TextBlock Style="{StaticResource TagText}" Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Preset" Width="60" IsReadOnly="True" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PresetGlyph}"
                                                               Foreground="{Binding PresetBrush}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Name" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Visibility="{Binding RefusedVisibility}"
                                                                Background="{DynamicResource DangerFill}"
                                                                CornerRadius="3"
                                                                Padding="5,1"
                                                                Margin="0,0,7,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Roblox refused this flag on the last launch. It is saved here, but it does nothing.">
                                                            <TextBlock Text="refused"
                                                                       Foreground="White"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontFamily="Cascadia Mono, Consolas" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource FlagCellEditor}"
                                                             FontFamily="Cascadia Mono, Consolas" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Value"
                                                            Width="*"
                                                            Binding="{Binding Value}"
                                                            EditingElementStyle="{StaticResource FlagCellEditor}"
                                                            FontFamily="Cascadia Mono, Consolas">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <StackPanel x:Name="EmptyStatePanel"
                                        Margin="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                <Path Data="{StaticResource IconFlag}"
                                      Stroke="{DynamicResource TextTertiary}"
                                      StrokeThickness="1.2"
                                      Width="34"
                                      Height="34"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyStateText"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiary}"
                                           Text="Go to Presets to add flags, or use Add new." />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource FluentButton}"
                                    Content="Export JSON"
                                    Margin="0,0,10,0"
                                    Click="ExportFlags_Click" />
                            <Button Style="{StaticResource FluentButton}"
                                    Content="Copy flags"
                                    Margin="0,0,10,0"
                                    Click="CopyFlags_Click" />
                            <Button Style="{StaticResource FluentButton}"
                                    Content="Import JSON"
                                    Margin="0,0,10,0"
                                    Click="ImportFlags_Click" />
                            <Button x:Name="FixFlagsButton"
                                    Style="{StaticResource FluentButton}"
                                    Content="Fix problems"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed"
                                    Click="FixFlags_Click" />
                            <TextBlock x:Name="FlagStatusText"
                                       Style="{StaticResource FlagsCaption}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="420"
                                       Text="" />
                        </WrapPanel>

                        <Border x:Name="LiveFlagCard" Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource CardHeader}" Text="Live flags" />
                                            <Border Background="{DynamicResource WarningText}"
                                                    CornerRadius="7"
                                                    Padding="7,1"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="RISKY"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ApplicationBackground}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Text="Writes your flags a second time straight into the running client's memory, after it has started, through the same native calls the reference tool uses. This can crash Roblox instantly, and Roblox may treat writes into its process as tampering. The normal file route always runs first and is unaffected by this." />
                                        <TextBlock x:Name="LiveFlagStatus"
                                                   Style="{StaticResource CardDescription}"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"
                                                   Text="" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Button x:Name="CheckLiveFlagsButton"
                                                Style="{StaticResource FluentButton}"
                                                Content="Check flags"
                                                Margin="0,0,8,0"
                                                Visibility="Collapsed"
                                                ToolTip="Reads the offset dump only. Writes nothing."
                                                Click="CheckLiveFlags_Click" />
                                        <Button x:Name="ApplyLiveFlagsButton"
                                                Style="{StaticResource FluentButton}"
                                                Content="Apply now"
                                                Margin="0,0,12,0"
                                                Visibility="Collapsed"
                                                ToolTip="Writes the flags into the Roblox that is running right now"
                                                Click="ApplyLiveFlags_Click" />
                                        <CheckBox x:Name="LiveFlagToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  Click="LiveFlags_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="HistoryExpander"
                                  Style="{StaticResource FluentExpander}"
                                  Margin="0,12,0,0"
                                  Header="FastFlag history"
                                  ToolTip="Every change is snapshotted before it is applied. Select an entry and press Undo selected, or double click it, to go back to that point.">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{StaticResource FluentButton}"
                                            Content="Undo selected"
                                            Margin="0,0,10,0"
                                            Click="UndoHistory_Click" />
                                    <Button Style="{StaticResource FluentButton}"
                                            Content="Clear history"
                                            Margin="0,0,10,0"
                                            Click="ClearHistory_Click" />
                                    <TextBlock x:Name="HistoryCountText"
                                               Style="{StaticResource FlagsCaption}"
                                               VerticalAlignment="Center"
                                               Text="No changes recorded" />
                                </StackPanel>

                                <ListBox x:Name="HistoryList"
                                         Style="{StaticResource FluentListBox}"
                                         MaxHeight="220"
                                         MouseDoubleClick="HistoryList_DoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Line}"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextTertiary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="AdvancedExpander"
                                  Style="{StaticResource FluentExpander}"
                                  Margin="0,10,0,0"
                                  Header="Raw JSON editor"
                                  ToolTip="Edit the flag object directly. Invalid JSON is rejected on save.">
                            <StackPanel>
                                <ctrl:CodeEditor x:Name="FastFlagsBox"
                                                 Style="{StaticResource CodeEditorStyle}"
                                                 Height="220" />
                                <Grid Margin="0,12,0,0">
                                    <TextBlock x:Name="FastFlagsStatus"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextTertiary}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource FluentButton}"
                                                Content="Reload"
                                                Click="ReloadFastFlags_Click" />
                                        <Button Style="{StaticResource AccentButton}"
                                                Content="Save flags"
                                                Margin="8,0,0,0"
                                                Click="SaveFastFlags_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel x:Name="PresetsView" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,4"
                                   Text="One-click sets of flags, taken from Voidstrap's preset table. Each says which flags it writes." />

                        <ItemsControl x:Name="PresetGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource CardHeader}" Text="{Binding Name}" FontSize="14" />
                                        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Description}" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource CardHeader}" Text="{Binding Name}" />
                                                                <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Description}" />
                                                                <TextBlock Style="{StaticResource CardDescription}"
                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                           FontFamily="Cascadia Mono, Consolas"
                                                                           FontSize="11"
                                                                           Margin="0,4,0,0"
                                                                           Text="{Binding FlagSummary}" />
                                                            </StackPanel>
                                                            <CheckBox Grid.Column="1"
                                                                      Style="{StaticResource ToggleSwitch}"
                                                                      Margin="16,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Style="{StaticResource NavItem}" Header="Modifications" Tag="{StaticResource IconPuzzle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Modifications" />
                    <TextBlock Style="{StaticResource PageDescription}" Text="Files placed here are copied over the version folder after extraction, mirroring its directory structure." />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Skybox" Margin="0,16,0,0" />

                    <TextBlock Style="{StaticResource PageDescription}"
                               Margin="0,0,0,4"
                               TextWrapping="Wrap"
                               Text="The sky Roblox falls back to when a place has not set one of its own. Six pictures make the cube. A place with its own Sky object overrides this, so it will not show everywhere." />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Custom sky" />
                                <TextBlock x:Name="SkyboxText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource FluentButton}"
                                        Content="One picture"
                                        Margin="0,0,8,0"
                                        Click="ChooseSkyboxAll_Click" />
                                <Button x:Name="ClearSkyboxButton"
                                        Style="{StaticResource FluentButton}"
                                        Content="Remove"
                                        Click="ClearSkybox_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Faces" Margin="0,0,0,8" />
                            <ItemsControl x:Name="SkyboxFaces">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Modifications folder" />
                                <TextBlock x:Name="ModsPathText" Style="{StaticResource CardDescription}" Text="" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource FluentButton}"
                                    Content="Open folder"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="OpenMods_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Presets" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Custom font" />
                                <TextBlock x:Name="CustomFontText" Style="{StaticResource CardDescription}" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="ChooseFontButton"
                                        Style="{StaticResource FluentButton}"
                                        Content="Choose font"
                                        Click="ChooseFont_Click" />
                                <Button x:Name="RemoveFontButton"
                                        Style="{StaticResource FluentButton}"
                                        Content="Remove"
                                        Margin="8,0,0,0"
                                        Click="RemoveFont_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Mouse cursor" />
                                <TextBlock x:Name="CursorAssetText" Style="{StaticResource CardDescription}" Text="" />
                            </StackPanel>
                            <ComboBox x:Name="CursorCombo"
                                      Grid.Column="1"
                                      Style="{StaticResource FluentComboBox}"
                                      Width="160"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="CursorCombo_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Emoji font" />
                                <TextBlock x:Name="EmojiStatusText" Style="{StaticResource CardDescription}" Text="Replaces the in-game emoji font. Downloaded on demand, so nothing needs to be supplied." />
                            </StackPanel>
                            <ComboBox x:Name="EmojiCombo"
                                      Grid.Column="1"
                                      Style="{StaticResource FluentComboBox}"
                                      Width="160"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="EmojiCombo_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Old character sounds" />
                                <TextBlock x:Name="SoundsAssetText" Style="{StaticResource CardDescription}" Text="" />
                            </StackPanel>
                            <CheckBox x:Name="OldSoundsToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="OldSoundsToggle_Changed"
                                      Unchecked="OldSoundsToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Old avatar editor background" />
                                <TextBlock x:Name="AvatarAssetText" Style="{StaticResource CardDescription}" Text="" />
                            </StackPanel>
                            <CheckBox x:Name="OldAvatarToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="OldAvatarToggle_Changed"
                                      Unchecked="OldAvatarToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Preset assets" />
                                <TextBlock x:Name="ModAssetsPathText" Style="{StaticResource CardDescription}" Text="" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource FluentButton}"
                                    Content="Open folder"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="OpenModAssets_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Style="{StaticResource NavItem}" Header="Integrations" Tag="{StaticResource IconPlug}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Integrations" />
                    <TextBlock Style="{StaticResource PageDescription}" Text="What Jello does while you are in a game, and what it tells the rest of your desktop about it." />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <ToggleButton x:Name="ActivityTabButton"
                                      Style="{StaticResource ChipToggle}"
                                      Content="Activity"
                                      Margin="0,0,8,0"
                                      IsChecked="True"
                                      Click="IntegrationView_Click" />
                        <ToggleButton x:Name="DiscordTabButton"
                                      Style="{StaticResource ChipToggle}"
                                      Content="Discord"
                                      Margin="0,0,8,0"
                                      Click="IntegrationView_Click" />
                        <ToggleButton x:Name="ProgramsTabButton"
                                      Style="{StaticResource ChipToggle}"
                                      Content="Programs"
                                      Click="IntegrationView_Click" />
                    </StackPanel>

                    <StackPanel x:Name="ActivityView">
                        <TextBlock Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Text="Everything here reads the Roblox client log. Nothing is injected into the game." />
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Game icon on the taskbar" />
                                <TextBlock x:Name="GameIconText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="CustomIconButton"
                                        Style="{StaticResource FluentButton}"
                                        Content="Custom"
                                        Margin="0,0,8,0"
                                        Click="ChooseCustomIcon_Click" />
                                <Button x:Name="ClearCustomIconButton"
                                        Style="{StaticResource FluentButton}"
                                        Content="Clear"
                                        Margin="0,0,8,0"
                                        Click="ClearCustomIcon_Click" />
                                <CheckBox x:Name="GameIconToggle"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Click="GameIcon_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Activity tracking" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Tails the Roblox log to work out which game and server you are in. Everything below depends on this." />
                            </StackPanel>
                            <CheckBox x:Name="ActivityTrackingToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="ActivityTrackingToggle_Changed"
                                      Unchecked="ActivityTrackingToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Look up server location" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Sends the server's IP address to ipinfo.io to resolve a city and country. Leave this off if you would rather not contact a third party." />
                            </StackPanel>
                            <CheckBox x:Name="ServerDetailsToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="ServerDetailsToggle_Changed"
                                      Unchecked="ServerDetailsToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Notify on server join" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Shows one notification each time you land in a new server. Clicking it opens the server information panel." />
                            </StackPanel>
                            <CheckBox x:Name="NotifyJoinToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="NotifyJoinToggle_Changed"
                                      Unchecked="NotifyJoinToggle_Changed" />
                        </Grid>
                    </Border>

                    </StackPanel>

                    <StackPanel x:Name="DiscordView" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Text="Publishes what you are playing to Discord over its local pipe. Discord has to be running on this machine; nothing is sent anywhere else." />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Show game activity on Discord" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Publishes the experience name, creator, server type and elapsed time to Discord over its local IPC pipe. Presence only appears once you are actually in an experience, not while Roblox sits on the home screen." />
                            </StackPanel>
                            <CheckBox x:Name="RichPresenceToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="RichPresenceToggle_Changed"
                                      Unchecked="RichPresenceToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Hide the join button" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Removes the Join server button from your presence, so nobody can jump into your public server from Discord. See game page always stays." />
                            </StackPanel>
                            <CheckBox x:Name="HideRpcButtonsToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="HideRpcButtonsToggle_Changed"
                                      Unchecked="HideRpcButtonsToggle_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Show how full the server is" />
                                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="Adds &quot;(4 of 12)&quot; to your Discord status, and puts the server kind and location on the small badge. Both come from the log Jello already reads." />
                            </StackPanel>
                            <CheckBox x:Name="ServerFillToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      Click="ServerFill_Click" />
                        </Grid>
                    </Border>
                    </StackPanel>

                    <StackPanel x:Name="ProgramsView" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Text="Programs launched alongside Roblox. Anything set to close automatically is shut down when Roblox exits." />
                    <Border Style="{StaticResource Card}">
                        <Grid Height="230">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ListBox x:Name="IntegrationsList"
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     Margin="0,0,12,0"
                                     Style="{StaticResource FluentListBox}"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="IntegrationSelection_Changed" />

                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,8,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource FluentButton}"
                                        Content="New"
                                        HorizontalContentAlignment="Center"
                                        Click="AddIntegration_Click" />
                                <Button x:Name="DeleteIntegrationButton"
                                        Grid.Column="2"
                                        Style="{StaticResource FluentButton}"
                                        Content="Delete"
                                        HorizontalContentAlignment="Center"
                                        Click="DeleteIntegration_Click" />
                            </Grid>

                            <TextBlock x:Name="NoIntegrationText"
                                       Grid.Row="0"
                                       Grid.RowSpan="2"
                                       Grid.Column="1"
                                       Text="No integration selected, please select or add a new one"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />

                            <StackPanel x:Name="IntegrationDetail"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Visibility="Collapsed">
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Name" />
                                <TextBox x:Name="IntegrationNameBox"
                                         Style="{StaticResource FluentTextBox}"
                                         Margin="0,0,0,10"
                                         TextChanged="IntegrationName_Changed" />

                                <TextBlock Style="{StaticResource InfoLabel}" Text="Application" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="IntegrationLocationBox"
                                             Grid.Column="0"
                                             Style="{StaticResource FluentTextBox}"
                                             LostFocus="IntegrationLocation_Changed" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource FluentButton}"
                                            Content="Browse"
                                            Margin="8,0,0,0"
                                            Click="BrowseIntegration_Click" />
                                </Grid>

                                <TextBlock Style="{StaticResource InfoLabel}" Text="Launch arguments" />
                                <TextBox x:Name="IntegrationArgsBox"
                                         Style="{StaticResource FluentTextBox}"
                                         Height="54"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,10"
                                         LostFocus="IntegrationArgs_Changed" />

                                <CheckBox x:Name="IntegrationAutoCloseBox"
                                          Content="Close automatically when Roblox exits"
                                          Foreground="{DynamicResource TextSecondary}"
                                          Checked="IntegrationAutoClose_Changed"
                                          Unchecked="IntegrationAutoClose_Changed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Style="{StaticResource NavItem}" Header="Optimizations" Tag="{StaticResource IconSpark}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Optimizations" />
                    <TextBlock Style="{StaticResource PageDescription}" Text="Reclaim disk space taken by old installs, caches and logs. Nothing is deleted until you review the list and confirm." />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Performance" Margin="0,16,0,0" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Quieten Roblox when you switch away" />
                                <TextBlock x:Name="DuckAudioText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <ComboBox x:Name="DuckLevelCombo"
                                          Style="{StaticResource FluentComboBox}"
                                          Width="120"
                                          Margin="0,0,8,0"
                                          SelectionChanged="DuckLevel_Changed" />
                                <CheckBox x:Name="DuckAudioToggle"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Click="DuckAudio_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="How much of the machine Roblox gets" />
                                <TextBlock x:Name="ResourceText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <ComboBox x:Name="CoreLimitCombo"
                                          Style="{StaticResource FluentComboBox}"
                                          Width="130"
                                          Margin="0,0,8,0"
                                          SelectionChanged="CoreLimit_Changed" />
                                <ComboBox x:Name="PriorityCombo"
                                          Style="{StaticResource FluentComboBox}"
                                          Width="140"
                                          SelectionChanged="Priority_Changed" />
                            </StackPanel>
                        </Grid>
                    </Border>


                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Frame rate cap" />
                                <TextBlock x:Name="FramerateText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                            </StackPanel>
                            <ComboBox x:Name="FramerateCombo"
                                      Grid.Column="1"
                                      Style="{StaticResource FluentComboBox}"

                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Dialog style" />
                                <TextBlock x:Name="BootstrapperStyleText" Style="{StaticResource CardDescription}" Text="" />

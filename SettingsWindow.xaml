                            <ComboBox x:Name="RobloxThemeCombo"
                                      Grid.Column="1"
                                      Style="{StaticResource FluentComboBox}"
                                      Width="150"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      SelectionChanged="RobloxTheme_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Style="{StaticResource NavItem}" Header="Lab" Tag="{StaticResource IconFlask}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Lab" />
                    <TextBlock Style="{StaticResource PageDescription}"
                               TextWrapping="Wrap"
                               Text="Experimental. Everything here reads the running Roblox client&apos;s memory directly, using the community offset tables for your build. It is off until you turn it on, and it is separate from the rest of Jello on purpose." />

                    <Border Style="{StaticResource Card}"
                            Margin="0,12,0,0"
                            Padding="14,11"
                            Background="{DynamicResource DangerFill}">
                        <TextBlock Foreground="White"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Text="Reading another program&apos;s memory is not something anti-cheat is meant to see, even when only reading. Nothing here writes to the client or touches a game. Use it on your own account, at your own discretion." />
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Enable the Lab" />
                                <TextBlock x:Name="LabText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                            </StackPanel>
                            <CheckBox x:Name="LabToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      Click="Lab_Click" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="LabTools" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Recolour the app" Margin="0,16,0,0" />

                        <TextBlock Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Text="Tints the Roblox app&apos;s own frames by writing to them directly - the real home screen, not a layer over it. This is the one thing that reaches it: no script, no injection. It writes to the client&apos;s memory, so it is experimental and off by default." />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardHeader}" Text="Tint the app" />
                                    <TextBlock x:Name="TintText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                                </StackPanel>
                                <CheckBox x:Name="TintToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Center"
                                          Click="Tint_Click" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardHeader}" Text="Colour" />
                                    <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="Full strength paints the flat colour; lower keeps some of the original so panels stay readable." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Border x:Name="TintSwatch"
                                            Width="26"
                                            Height="26"
                                            CornerRadius="4"
                                            Margin="0,0,8,0"
                                            Cursor="Hand"
                                            ToolTip="Pick a colour"
                                            BorderBrush="{DynamicResource ControlStrokeSecondary}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"
                                            MouseLeftButtonUp="TintSwatch_Click" />
                                    <TextBox x:Name="TintColourBox"
                                             Style="{StaticResource FluentTextBox}"
                                             Width="110"
                                             Margin="0,0,8,0"
                                             FontFamily="Cascadia Mono, Consolas"
                                             TextChanged="TintColour_Changed" />
                                    <ComboBox x:Name="TintStrengthCombo"
                                              Style="{StaticResource FluentComboBox}"
                                              Width="130"
                                              SelectionChanged="TintStrength_Changed" />

                                    <Popup x:Name="ColorPickerPopup"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           Placement="Bottom"
                                           PlacementTarget="{Binding ElementName=TintSwatch}"
                                           VerticalOffset="6"
                                           Closed="ColorPicker_Closed">
                                        <Border Background="{DynamicResource PopupBackground}"
                                                BorderBrush="{DynamicResource ControlStroke}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Padding="12"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Width="200">
                                                <Border Width="200" Height="150" CornerRadius="4" ClipToBounds="True"
                                                        BorderBrush="{DynamicResource ControlStrokeSecondary}" BorderThickness="1">
                                                    <Grid>
                                                        <Rectangle x:Name="SvHueRect" Fill="#FF0000" />
                                                        <Rectangle>
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Offset="0" Color="#FFFFFFFF" />
                                                                    <GradientStop Offset="1" Color="#00FFFFFF" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                        <Rectangle>
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Offset="0" Color="#00000000" />
                                                                    <GradientStop Offset="1" Color="#FF000000" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                        <Canvas x:Name="SvCanvas" Background="Transparent"
                                                                MouseLeftButtonDown="Sv_MouseDown"
                                                                MouseMove="Sv_MouseMove"
                                                                MouseLeftButtonUp="Sv_MouseUp">
                                                            <Border x:Name="SvThumb" Width="12" Height="12" CornerRadius="6"
                                                                    BorderBrush="White" BorderThickness="2"
                                                                    IsHitTestVisible="False" />
                                                        </Canvas>
                                                    </Grid>
                                                </Border>

                                                <Border Width="200" Height="14" Margin="0,12,0,0" CornerRadius="7" ClipToBounds="True"
                                                        BorderBrush="{DynamicResource ControlStrokeSecondary}" BorderThickness="1">
                                                    <Grid>
                                                        <Rectangle>
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Offset="0.000" Color="#FF0000" />
                                                                    <GradientStop Offset="0.166" Color="#FFFF00" />
                                                                    <GradientStop Offset="0.333" Color="#00FF00" />
                                                                    <GradientStop Offset="0.500" Color="#00FFFF" />
                                                                    <GradientStop Offset="0.666" Color="#0000FF" />
                                                                    <GradientStop Offset="0.833" Color="#FF00FF" />
                                                                    <GradientStop Offset="1.000" Color="#FF0000" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                        <Canvas x:Name="HueCanvas" Background="Transparent"
                                                                MouseLeftButtonDown="Hue_MouseDown"
                                                                MouseMove="Hue_MouseMove"
                                                                MouseLeftButtonUp="Hue_MouseUp">
                                                            <Border x:Name="HueThumb" Width="6" Height="14" CornerRadius="2"
                                                                    BorderBrush="White" BorderThickness="2" Background="#40000000"
                                                                    IsHitTestVisible="False" />
                                                        </Canvas>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                                    <Border x:Name="PickerPreview" Width="26" Height="26" CornerRadius="4"
                                                            BorderBrush="{DynamicResource ControlStrokeSecondary}" BorderThickness="1"
                                                            Margin="0,0,8,0" />
                                                    <TextBox x:Name="PickerHexBox"
                                                             Style="{StaticResource FluentTextBox}"
                                                             Width="92"
                                                             FontFamily="Cascadia Mono, Consolas"
                                                             VerticalAlignment="Center"
                                                             TextChanged="PickerHex_Changed" />
                                                    <Button Content="Done"
                                                            Style="{StaticResource FluentButton}"
                                                            Margin="8,0,0,0"
                                                            Click="ColorPickerDone_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Live client inspector" Margin="0,16,0,0" />

                        <TextBlock Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Text="Reads the running client&apos;s live instance tree - the real services and GUI, not what the log implies. Read only." />

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardHeader}" Text="Read the client now" />
                                    <TextBlock x:Name="InspectorText2" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="Roblox has to be running." />
                                </StackPanel>
                                <Button x:Name="InspectButton"
                                        Grid.Column="1"
                                        Style="{StaticResource AccentButton}"
                                        Content="Read"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="Inspect_Click" />
                            </Grid>
                        </Border>

                        <Border x:Name="InspectorResult" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="InspectorServices"
                                           Style="{StaticResource CardDescription}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Text="" />
                                <ItemsControl x:Name="InspectorFrames" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Override offsets" Margin="0,16,0,0" />

                        <TextBlock Style="{StaticResource PageDescription}"
                                   Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Text="Jello fetches the offset tables for your build from the published sources. If you have your own - for a build no source has caught up with, or a set you trust more - paste them here and they are used instead. Turn the Lab off and this same panel moves to its own Offsets tab." />

                        <ContentControl x:Name="OverrideHostLab" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="OffsetsTab" Style="{StaticResource NavItem}" Header="Offsets" Tag="{StaticResource IconDocument}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Offsets" />
                    <TextBlock Style="{StaticResource PageDescription}"
                               TextWrapping="Wrap"
                               Text="Jello fetches the offset tables it needs for your Roblox build from the published sources. Paste your own here to use them in place of a fetch - for a build no source has caught up with, or a set you trust more. This tab appears while the Lab is off; turn the Lab on and this same panel moves there." />

                    <ContentControl x:Name="OverrideHostTab" Margin="0,4,0,0">
                        <StackPanel x:Name="OverridePanel">
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardHeader}" Text="Use my own offsets" />
                                        <TextBlock x:Name="OverrideText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                                    </StackPanel>
                                    <CheckBox x:Name="OverrideToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              Click="Override_Click" />
                                </Grid>
                            </Border>

                            <StackPanel x:Name="OverrideBoxes" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource CardHeader}" Text="Memory layout offsets" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource HelpBadge}"
                                                    ToolTip="The grouped struct offsets the Lab walker reads to find instances in the running client - the &quot;.memory.json&quot; table. Shape: an object with a &quot;Roblox Version&quot; stamp and an &quot;Offsets&quot; object of groups. Only affects the Lab.">
                                                <TextBlock Style="{StaticResource HelpBadgeMark}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="MemoryOffsetsStatus"
                                                   Style="{StaticResource CardDescription}"
                                                   TextWrapping="Wrap"
                                                   Text="" />
                                        <TextBox x:Name="MemoryOffsetsBox"
                                                 Style="{StaticResource FluentTextBox}"
                                                 Margin="0,10,0,0"
                                                 Height="120"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 FontSize="12"
                                                 TextChanged="MemoryOffsets_Changed" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource CardHeader}" Text="FastFlag offsets" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource HelpBadge}"
                                                    ToolTip="The flat name-to-address map live flag injection writes through - one address per FastFlag in this build. Shape: an object with a &quot;BuildVersion&quot; stamp and an &quot;Offsets&quot; object of name to number. Used by live flags on the FastFlags page.">
                                                <TextBlock Style="{StaticResource HelpBadgeMark}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="FlagOffsetsStatus"
                                                   Style="{StaticResource CardDescription}"
                                                   TextWrapping="Wrap"
                                                   Text="" />
                                        <TextBox x:Name="FlagOffsetsBox"
                                                 Style="{StaticResource FluentTextBox}"
                                                 Margin="0,10,0,0"
                                                 Height="120"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 FontSize="12"
                                                 TextChanged="FlagOffsets_Changed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </TabItem>

            <TabItem Style="{StaticResource NavItem}" Header="Privacy" Tag="{StaticResource IconShield}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Privacy" />
                    <TextBlock Style="{StaticResource PageDescription}" Text="What leaves this machine, and who can see Jello while it is open." />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Telemetry" Margin="0,16,0,0" />

                    <TextBlock Style="{StaticResource PageDescription}"
                               Margin="0,0,0,4"
                               TextWrapping="Wrap"
                               Text="Roblox sends counters, traces and crash reports to a handful of its own hosts. This points those names at nowhere, in the Windows hosts file. Two things follow from that: it needs administrator rights, so Windows will ask; and it applies to every program on this computer, not only to Roblox. Roblox itself keeps working - none of these carry anything a game needs." />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Block Roblox telemetry" />
                                <TextBlock x:Name="TelemetryText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="TelemetryHostsButton"
                                        Style="{StaticResource FluentButton}"
                                        Content="Show hosts"
                                        Margin="0,0,8,0"
                                        Click="ShowTelemetryHosts_Click" />
                                <CheckBox x:Name="TelemetryToggle"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Click="Telemetry_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="On screen" Margin="0,16,0,0" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Secure UI" />
                                <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap" Text="Hides Jello's windows from screenshots, screen recording and screen sharing. They stay visible on your own display." />
                            </StackPanel>
                            <CheckBox x:Name="SecureToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      Checked="SecureToggle_Changed"
                                      Unchecked="SecureToggle_Changed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Style="{StaticResource NavItem}" Header="Settings" Tag="{StaticResource IconWindow}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
                    <TextBlock Style="{StaticResource PageDescription}" Text="How Jello's own windows are drawn, where they sit, and how they behave when the screen is captured. These apply to the launcher, this window and the server panel alike." />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Acrylic blur" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Translucent background that samples the desktop behind the window. Turning this off falls back to a solid background." />
                            </StackPanel>
                            <CheckBox x:Name="AcrylicToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="AcrylicToggle_Changed"
                                      Unchecked="AcrylicToggle_Changed" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Placement" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Always on top" />
                                <TextBlock Style="{StaticResource CardDescription}" Text="Keeps Jello above other windows, including full-screen borderless games." />
                            </StackPanel>
                            <CheckBox x:Name="TopmostToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Checked="TopmostToggle_Changed"
                                      Unchecked="TopmostToggle_Changed" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Privacy" />

                </StackPanel>
            </TabItem>

            <TabItem Style="{StaticResource NavItemBottom}" Header="About" Tag="{StaticResource IconInfo}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="About" />

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Style="{StaticResource LogoMark}"
                                       Width="144"
                                       Height="144"
                                       VerticalAlignment="Center" />
                            <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Jello Client"
                                           FontFamily="{StaticResource PoppinsFont}"
                                           FontWeight="Bold"
                                           FontSize="30"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="AppVersionText"
                                           FontFamily="{StaticResource PoppinsFont}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource CardDescription}"
                                           Text="A Roblox bootstrapper for FastFlags, modifications and optimizations."
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Updates" />
                                <TextBlock x:Name="AppUpdateStatusText"
                                           Style="{StaticResource CardDescription}"
                                           Text="Jello updates itself from its GitHub releases." />
                            </StackPanel>
                            <Button x:Name="AppUpdateButton"
                                    Grid.Column="1"
                                    Style="{StaticResource FluentButton}"
                                    Content="Check for updates"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="AppUpdate_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Install location" />
                            <TextBlock x:Name="BasePathText" Style="{StaticResource CardDescription}" Text="" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Session log" />
                                <TextBlock x:Name="LogPathText" Style="{StaticResource CardDescription}" Text="" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource FluentButton}"
                                    Content="Open logs"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="OpenLogs_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Links" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="The project, the channel, and the Discord." />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource LinkIconButton}"
                                        Content="{StaticResource IconGitHub}"
                                        ToolTip="GitHub"
                                        Tag="https://github.com/aebkjayboo/JelloClient"
                                        Margin="0,0,10,0"
                                        Click="OpenLink_Click" />
                                <Button Style="{StaticResource LinkIconButton}"
                                        Content="{StaticResource IconYouTube}"
                                        ToolTip="YouTube"
                                        Tag="https://www.youtube.com/@its-skondo"
                                        Margin="0,0,10,0"
                                        Click="OpenLink_Click" />
                                <Button Style="{StaticResource LinkIconButton}"
                                        Content="{StaticResource IconDiscordBrand}"
                                        ToolTip="Discord"
                                        Tag="https://discord.gg/tpnP9NNBap"
                                        Click="OpenLink_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Credits" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource CardDescription}" Text="Made by " VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource AccentLink}"
                                           Text="Sai"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           ToolTip="https://www.youtube.com/@its-skondo"
                                           Tag="https://www.youtube.com/@its-skondo"
                                           MouseLeftButtonUp="OpenLink_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Licenses" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Jello is MIT licensed. These are the projects whose code or assets it actually uses." />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource FluentButton}" Content="Jello Client (MIT)" Margin="0,0,8,8"
                                        Tag="https://github.com/aebkjayboo/JelloClient/blob/main/LICENSE" Click="OpenLink_Click" />
                                <Button Style="{StaticResource FluentButton}" Content="Bloxstrap (MIT)" Margin="0,0,8,8"
                                        Tag="https://github.com/bloxstraplabs/bloxstrap/blob/main/LICENSE" Click="OpenLink_Click" />
                                <Button Style="{StaticResource FluentButton}" Content="Poppins (OFL 1.1)" Margin="0,0,8,8"
                                        Tag="https://github.com/google/fonts/blob/main/ofl/poppins/OFL.txt" Click="OpenLink_Click" />
                                <Button Style="{StaticResource FluentButton}" Content="Lucide (ISC)" Margin="0,0,8,8"
                                        Tag="https://github.com/lucide-icons/lucide/blob/main/LICENSE" Click="OpenLink_Click" />
                                <Button Style="{StaticResource FluentButton}" Content="WebView2 (BSD-3)" Margin="0,0,8,8"
                                        Tag="https://www.nuget.org/packages/Microsoft.Web.WebView2/license" Click="OpenLink_Click" />
                                <Button Style="{StaticResource FluentButton}" Content="Roblox assets" Margin="0,0,8,8"
                                        Tag="https://en.help.roblox.com/hc/en-us/articles/115004647846" Click="OpenLink_Click" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Text="Bloxstrap covers the mod preset mechanism and the bundled preset files. The cursor, sound and avatar-background binaries inside those presets are Roblox Corporation's, not Bloxstrap's. Full text ships in THIRD-PARTY-NOTICES.md." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>

        <Border Grid.Row="3"
                BorderBrush="{DynamicResource ControlStroke}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextTertiary}" />
                <Button Grid.Column="1"
                        Style="{StaticResource FluentButton}"
                        Content="Close"
                        Margin="12,0,0,0"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</ui:JelloWindow>

                                           Foreground="{DynamicResource TextTertiary}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Text="Roblox's own executable is signed, so its embedded icon cannot be replaced without breaking that signature. This makes a shortcut that launches Roblox through Jello with the icon you pick instead." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource FluentButton}"
                                        Content="Choose icon"
                                        Margin="0,0,8,0"
                                        Click="ChooseShortcutIcon_Click" />
                                <Button x:Name="RemoveShortcutButton"
                                        Style="{StaticResource FluentButton}"
                                        Content="Remove"
                                        Click="RemoveShortcut_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Roblox app theme" />

                    <TextBlock Style="{StaticResource PageDescription}"
                               Margin="0,0,0,4"
                               TextWrapping="Wrap"
                               Text="Light or dark for the Roblox app itself - the home screen where you browse games. This is the real theme, not a picture laid over it: the Roblox app asks Windows what colour mode to use, so setting that here changes it properly, and the running client follows straight away without a relaunch.&#10;&#10;The catch is that it is a Windows setting, so every other program on this computer changes with it. Leave alone does nothing at all. The colour themes in Roblox's own Device Preferences, like Lava Glow, are a Roblox Plus feature chosen on Roblox's servers and nothing here can reach them." />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

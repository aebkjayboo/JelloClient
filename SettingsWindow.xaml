                    <TextBlock Style="{StaticResource SectionHeader}" Text="Roblox shortcut" />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeader}" Text="Desktop shortcut icon" />
                                <TextBlock x:Name="ShortcutText" Style="{StaticResource CardDescription}" Text="" />
